; ---------------------------------------------------------------- fonts
; IBM Plex Mono ships Regular only. Synthesise the bold face so [b] in a
; RichTextLabel cannot fall through to Godot's built-in proportional sans.

[sub_resource type="FontVariation" id="Font_bold"]
base_font = ExtResource("1_mono")
variation_embolden = 0.6

[sub_resource type="FontVariation" id="Font_tracked"]
base_font = ExtResource("1_mono")
spacing_glyph = 2

